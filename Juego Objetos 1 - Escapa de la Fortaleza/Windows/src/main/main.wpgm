import wollok.game.*
import visuales.menuInicio.*
import sistemaDeSalas.configuracionJuego.*
import sistemaDeSalas.sistemaSonido.*

program escapaDeLaFortaleza {
  configuracionJuego.iniciar()
  sistemaSonido.iniciar()
  keyboard.plusKey().onPressDo({ sistemaSonido.subirVolumen() })
  keyboard.minusKey().onPressDo({ sistemaSonido.bajarVolumen() })
  menuInicio.mostrar()
  game.start()
}
