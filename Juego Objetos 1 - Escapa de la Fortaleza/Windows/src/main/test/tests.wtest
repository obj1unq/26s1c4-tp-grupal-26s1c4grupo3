describe "Marca de herida al recibir daño (SerVivo)" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "Si un mismo enemigo recibe varios golpes seguidos, la marca de herida no se acumula" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    game.addVisual(esqueleto)

    esqueleto.recibirAtaque(1)
    esqueleto.recibirAtaque(1)
    esqueleto.recibirAtaque(1)

    assert.equals(1, game.allVisuals().count { visual => visual.image() == "heridaSangrado.png" })
  }

  test "Si varios enemigos distintos son golpeados al mismo tiempo, cada uno muestra su propia marca de herida" {
    prisionero.ubicarEn(game.at(18, 5), arriba)
    prisionero.mover(arriba)
    prisionero.equiparArma(espada)
    const esqueletoIzquierda = new EnemigoEsqueleto(position = game.at(17, 7))
    const esqueletoCentro = new EnemigoEsqueleto(position = game.at(18, 7))
    const esqueletoDerecha = new EnemigoEsqueleto(position = game.at(19, 7))
    game.addVisual(esqueletoIzquierda)
    game.addVisual(esqueletoCentro)
    game.addVisual(esqueletoDerecha)

    prisionero.atacar()

    assert.equals(3, game.allVisuals().count { visual => visual.image() == "heridaSangrado.png" })
  }

}

