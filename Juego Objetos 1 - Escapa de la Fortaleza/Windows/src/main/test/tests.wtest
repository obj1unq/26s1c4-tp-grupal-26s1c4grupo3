  test "Atacar no debería afectar ni romper si un objeto no-enemigo (ej. el HUD del arma) cae dentro del alcance" {
    // PENDIENTE: habia un bug porque ni hud ni fondo tenian el metodo .esEnemigo(), ya agregado pero test pendiente
    assert.that(true)
  }

}

describe "Escalado de dificultad de los enemigos" {

  test "Con multiplicador 1, un esqueleto mantiene su vida base" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(0, 0))

    esqueleto.escalarPorDificultad(1)

    assert.equals(100, esqueleto.vida())
  }

  test "Con multiplicador 2, un esqueleto duplica su vida" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(0, 0))

    esqueleto.escalarPorDificultad(2)

    assert.equals(200, esqueleto.vida())
  }

  test "El multiplicador redondea la vida resultante a un número entero" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(0, 0))

    esqueleto.escalarPorDificultad(1.33)

    assert.equals(133, esqueleto.vida())
  }

  test "La fuerza escalada se refleja en el daño que inflige al atacar" {
    game.width(25)
    game.height(25)
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    esqueleto.escalarPorDificultad(2)
    prisionero.ubicarEn(game.at(10, 10), arriba)
    prisionero.vida(100)

    esqueleto.atacar(prisionero)

    assert.equals(70, prisionero.vida()) // fuerza base 15 * 2 = 30 de daño
  }

}

describe "Movimiento autónomo del enemigo hacia su objetivo" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "Si la diferencia en X hacia el objetivo es mayor que en Y, el enemigo se mueve un paso en el eje X" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.ubicarEn(game.at(15, 11), arriba)

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(11, 10), esqueleto.position())
  }

  test "Si la diferencia en Y hacia el objetivo es mayor que en X, el enemigo se mueve un paso en el eje Y" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.ubicarEn(game.at(11, 15), arriba)

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(10, 11), esqueleto.position())
  }

  test "Si la dirección principal está bloqueada por el límite del mapa, el enemigo se mueve en la dirección alternativa" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(3, 10))
    prisionero.ubicarEn(game.at(-5, 11), arriba)

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(3, 11), esqueleto.position())
  }

  test "Si el enemigo ya está en la misma posición que el objetivo, no se mueve" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.ubicarEn(game.at(10, 10), arriba)

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(10, 10), esqueleto.position())
  }

  test "Si las dos direcciones candidatas están bloqueadas, el enemigo no se mueve" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(1, 1))
    prisionero.ubicarEn(game.at(-2, -2), arriba)

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(1, 1), esqueleto.position())
  }

}

describe "Comportamiento de ataque de los enemigos" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "Si el objetivo está en una posición adyacente (incluida la diagonal), el enemigo lo ataca en vez de moverse" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.ubicarEn(game.at(11, 11), arriba)
    prisionero.vida(100)

    esqueleto.actuar(prisionero)

    assert.equals(85, prisionero.vida())
    assert.equals(game.at(10, 10), esqueleto.position())
  }

  test "Si el objetivo está a 2 o más casilleros de distancia en cualquier eje, el enemigo se mueve hacia él en vez de atacar" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.ubicarEn(game.at(13, 10), arriba)
    prisionero.vida(100)

    esqueleto.actuar(prisionero)

    assert.equals(100, prisionero.vida())
    assert.equals(game.at(11, 10), esqueleto.position())
  }

}

describe "Generadores de enemigos por tipo" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "generadorDeEsqueletos crea un EnemigoEsqueleto en cada posición dada" {
    const enemigos = generadorDeEsqueletos.crear([game.at(3, 3), game.at(4, 4)])

    assert.equals(2, enemigos.size())
    assert.that(enemigos.all { enemigo => enemigo.image() == "enemigos\\enemigoEsqueleto.png" })
    assert.equals(game.at(3, 3), enemigos.get(0).position())
  }

  test "generadorDeBestias crea un EnemigoBestia en cada posición dada" {
    const enemigos = generadorDeBestias.crear([game.at(5, 5)])

    assert.equals(1, enemigos.size())
    assert.equals("enemigos\\enemigoBestia.png", enemigos.get(0).image())
  }

}

describe "Selección de arma inicial" {

  method initialize() {
    game.width(25)
    game.height(25)
    gestorArmas.configurarArmasIniciales()
    prisionero.equiparArma(sinArma)
  }

  test "Si el personaje está parado sobre un arma y elige, queda equipada" {
    prisionero.ubicarEn(game.at(10, 9), arriba)

    gestorArmas.intentarElegirArma()

    assert.equals(50, prisionero.poderDeAtaque()) // fuerzaBase 10 + poder espada 30
  }

  test "Si el personaje no está parado sobre ningún arma, intentar elegir no hace nada" {
    prisionero.ubicarEn(game.at(0, 0), arriba)

    gestorArmas.intentarElegirArma()

    assert.equals(10, prisionero.poderDeAtaque()) // sigue con sinArma
  }

  test "Antes de elegir ningún arma, armaYaElegida está en false" {
    assert.that(!gestorArmas.armaYaElegida())
  }

  test "Una vez elegida un arma, armaYaElegida pasa a estar en true" {
    prisionero.ubicarEn(game.at(12, 9), arriba)

    gestorArmas.intentarElegirArma()

    assert.that(gestorArmas.armaYaElegida())
  }

  test "configurarArmasIniciales ubica las 3 armas en sus posiciones del mapa" {
    prisionero.ubicarEn(game.at(14, 9), arriba)

    assert.that(gestorArmas.hayArmaEnLaPosicionDelPersonaje())
  }

}

describe "Recompensas aplican su efecto al personaje" {

  method initialize() {
    prisionero.prepararParaNuevaPartida()
  }

  test "PocionDeCuracion cura 30 puntos de vida sin superar la vida máxima" {
    prisionero.vida(50)

    new PocionDeCuracion().aplicarEfecto(prisionero)

    assert.equals(80, prisionero.vida())
  }

  test "PocionDeCuracion no cura por encima de la vida máxima" {
    prisionero.vida(90)

    new PocionDeCuracion().aplicarEfecto(prisionero)

    assert.equals(100, prisionero.vida())
  }

  test "MejoraDeVidaMaxima aumenta la vida máxima y cura la diferencia de inmediato" {
    prisionero.vida(50)

    new MejoraDeVidaMaxima().aplicarEfecto(prisionero)

    assert.equals(70, prisionero.vida())
  }

  test "Tras una mejora de vida máxima, el nuevo tope de curación queda más alto" {
    prisionero.vida(50)
    new MejoraDeVidaMaxima().aplicarEfecto(prisionero)

    prisionero.curar(1000)

    assert.equals(120, prisionero.vida())
  }

  test "sinRecompensa no tiene ningún efecto sobre el personaje" {
    prisionero.vida(50)

    sinRecompensa.aplicarEfecto(prisionero)

    assert.equals(50, prisionero.vida())
  }

  test "sinRecompensa nunca es recogida" {
    assert.that(!sinRecompensa.fueRecogidaPor(prisionero))
  }

}

describe "Decisión aleatoria de recompensas" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "Con probabilidad 100, azar.ocurreConProbabilidad siempre da true" {
    assert.that(azar.ocurreConProbabilidad(100))
  }

  test "Con probabilidad 0, azar.ocurreConProbabilidad siempre da false" {
    assert.that(!azar.ocurreConProbabilidad(0))
  }

  test "Con probabilidad 100, ConfiguracionDeRecompensa siempre decide una recompensa que aplica su efecto real" {
    const configuracion = new ConfiguracionDeRecompensa(candidatas = [fabricaDePocionDeCuracion], probabilidad = 100, posicion = game.at(5, 5))
    prisionero.vida(50)

    configuracion.decidirRecompensa().aplicarEfecto(prisionero)

    assert.equals(80, prisionero.vida())
  }

  test "Con probabilidad 0, ConfiguracionDeRecompensa nunca decide una recompensa con efecto real" {
    const configuracion = new ConfiguracionDeRecompensa(candidatas = [fabricaDePocionDeCuracion], probabilidad = 0, posicion = game.at(5, 5))
    prisionero.vida(50)

    configuracion.decidirRecompensa().aplicarEfecto(prisionero)

    assert.equals(50, prisionero.vida())
  }

  test "fabricaDePocionDeCuracion crea una poción de curación" {
    assert.equals("manzana.png", fabricaDePocionDeCuracion.crear().image())
  }

  test "fabricaDeMejoraDeVidaMaxima crea una mejora de vida máxima" {
    assert.equals("llegada.png", fabricaDeMejoraDeVidaMaxima.crear().image())
  }

}

describe "Configuración de cada sala según su nivel" {

  test "SalaNivel1 usa el fondo del primer piso, esqueletos y multiplicador 1" {
    const sala = new SalaNivel1()

    assert.equals("mapas\\fondoPrimerNivel.png", sala.fondo())
    assert.equals(generadorDeEsqueletos, sala.generadorDeEnemigos())
    assert.equals(1, sala.multiplicadorDificultad())
  }

  test "SalaNivel2 usa el fondo del segundo piso, bestias y multiplicador 1.4" {
    const sala = new SalaNivel2()

    assert.equals("mapas\\fondoSegundoNivel.png", sala.fondo())
    assert.equals(generadorDeBestias, sala.generadorDeEnemigos())
    assert.equals(1.4, sala.multiplicadorDificultad())
  }

  test "SalaNivel3 usa el fondo del tercer piso, esqueletos y multiplicador 1.8" {
    const sala = new SalaNivel3()

    assert.equals("mapas\\fondoTercerNivel.png", sala.fondo())
    assert.equals(generadorDeReyOscuro, sala.generadorDeEnemigos())
    assert.equals(1.8, sala.multiplicadorDificultad())
  }

  test "SalaInicial hereda la configuración de SalaNivel1" {
    const sala = new SalaInicial()

    assert.equals("mapas\\fondoPrimerNivel.png", sala.fondo())
    assert.equals(1, sala.multiplicadorDificultad())
  }

}

describe "Una sala se completa cuando mueren todos sus enemigos" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "salaCompleta es false mientras haya al menos un enemigo vivo" {
    const sala = new SalaNivel1()
    sala.configurarEnemigos()

    assert.that(!sala.salaCompleta())
  }

  test "salaCompleta es true cuando todos los enemigos mueren" {
    const sala = new SalaNivel1()
    sala.configurarEnemigos()

    sala.enemigosDeLaSala().forEach { enemigo => enemigo.recibirAtaque(1000) }

    assert.that(sala.salaCompleta())
  }

  test "puedeAvanzar es true cuando la sala está completa y el personaje llegó a la puerta" {
    const sala = new SalaNivel1()
    sala.configurarEnemigos()
    sala.enemigosDeLaSala().forEach { enemigo => enemigo.recibirAtaque(1000) }
    prisionero.ubicarEn(sala.puerta().posicion(), abajo)

    assert.that(sala.puedeAvanzar())
  }

  test "puedeAvanzar es false si la sala está completa pero el personaje no llegó a la puerta" {
    const sala = new SalaNivel1()
    sala.configurarEnemigos()
    sala.enemigosDeLaSala().forEach { enemigo => enemigo.recibirAtaque(1000) }
    prisionero.ubicarEn(game.at(1, 1), abajo)

    assert.that(!sala.puedeAvanzar())
  }

  test "puedeAvanzar es false si el personaje está en la puerta pero quedan enemigos vivos" {
    const sala = new SalaNivel1()
    sala.configurarEnemigos()
    prisionero.ubicarEn(sala.puerta().posicion(), abajo)

    assert.that(!sala.puedeAvanzar())
  }

}

class SalaDePrueba inherits SalaNivel1 {
  override method configuracionDeRecompensa() =
    new ConfiguracionDeRecompensa(candidatas = [fabricaDePocionDeCuracion], probabilidad = 100, posicion = game.at(12, 16))
}

describe "Ciclo completo de recompensas en una sala" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "La recompensa no aparece mientras queden enemigos vivos" {
    const sala = new SalaDePrueba()
    sala.configurarEnemigos()

    sala.intentarSpawnearRecompensa()

    assert.that(!game.allVisuals().any { visual => visual.image() == "manzana.png" })
  }

  test "Al completar la sala, la recompensa aparece en su posición y cura al pisarla" {
    const sala = new SalaDePrueba()
    sala.configurarEnemigos()
    sala.enemigosDeLaSala().forEach { enemigo => enemigo.recibirAtaque(1000) }
    prisionero.vida(50)

    sala.intentarSpawnearRecompensa()
    prisionero.ubicarEn(game.at(12, 16), abajo)
    sala.intentarRecogerRecompensa()

    assert.equals(80, prisionero.vida())
  }

  test "Una vez recogida, la misma recompensa no se puede volver a recoger" {
    const sala = new SalaDePrueba()
    sala.configurarEnemigos()
    sala.enemigosDeLaSala().forEach { enemigo => enemigo.recibirAtaque(1000) }
    prisionero.vida(50)
    sala.intentarSpawnearRecompensa()
    prisionero.ubicarEn(game.at(12, 16), abajo)
    sala.intentarRecogerRecompensa()
    prisionero.vida(50)

    sala.intentarRecogerRecompensa()

    assert.equals(50, prisionero.vida())
  }

}

describe "Vida, curación y vida máxima del personaje" {

  method initialize() {
    prisionero.prepararParaNuevaPartida()
  }

  test "recibirAtaque resta vida y nunca baja de 0" {
    prisionero.recibirAtaque(1000)

    assert.equals(0, prisionero.vida())
  }

  test "curar no supera la vida máxima" {
    prisionero.vida(90)

    prisionero.curar(30)

    assert.equals(100, prisionero.vida())
  }

  test "aumentarVidaMaxima sube el tope y cura la diferencia de inmediato" {
    prisionero.vida(50)

    prisionero.aumentarVidaMaxima(20)

    assert.equals(70, prisionero.vida())
  }

  test "prepararParaNuevaPartida resetea vida, vida máxima y arma" {
    prisionero.vida(10)
    prisionero.equiparArma(espada)
    new MejoraDeVidaMaxima().aplicarEfecto(prisionero)

    prisionero.prepararParaNuevaPartida()

    assert.equals(100, prisionero.vida())
    assert.equals(10, prisionero.poderDeAtaque()) // fuerzaBase 10 + sinArma.poder() 0
  }

  test "Al llegar a 0 de vida, se muestra la pantalla de derrota" {
    prisionero.recibirAtaque(1000)

    assert.equals("carteles\\cartel_derrota.jpg", fondo.image())
  }

}

describe "gestorDeNiveles recorre la secuencia de salas" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "iniciarPartida arranca en la primera sala de la secuencia" {
    gestorDeNiveles.iniciarPartida()

    assert.equals("mapas\\fondoPrimerNivel.png", gestorDeNiveles.salaActual().fondo())
  }

  test "iniciarPartida deja al personaje sin arma equipada y con la vida al máximo" {
    prisionero.equiparArma(espada)
    prisionero.vida(10)

    gestorDeNiveles.iniciarPartida()

    assert.equals(10, prisionero.poderDeAtaque()) // fuerzaBase 10 + sinArma.poder() 0
    assert.equals(100, prisionero.vida())
  }

  test "avanzar recorre la secuencia de salas en orden" {
    gestorDeNiveles.iniciarPartida()

    gestorDeNiveles.avanzar()
    //gestorDeNiveles.avanzar()
    // comentado por reduccion temporal de salas hasta la version final (ver gestorDeNiveles.wlk)

    assert.equals("mapas\\fondoSegundoNivel.png", gestorDeNiveles.salaActual().fondo())
  }

  test "al agotar la secuencia de salas, avanzar dispara el nivel boss" {
    gestorDeNiveles.iniciarPartida()

    5.times { i => gestorDeNiveles.avanzar() }
    gestorDeNiveles.avanzar()

    assert.equals("mapas\\fondoTercerNivel.png", fondo.image())
  }

}

describe "La vida del personaje persiste al pasar de una sala a otra" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "Al completar una sala y cruzar la puerta, la vida se mantiene en la siguiente sala" {
    gestorDeNiveles.iniciarPartida()
    prisionero.vida(35)
    const sala = gestorDeNiveles.salaActual()
    sala.enemigosDeLaSala().forEach { enemigo => enemigo.recibirAtaque(1000) }
    prisionero.ubicarEn(sala.puerta().posicion().up(1), arriba)

    sala.moverYVerificar(abajo)

    assert.equals(35, prisionero.vida())
  }

}

describe "CooldownManager" {

  test "Recién creado, el cooldown está listo sin necesidad de esperar" {
    const cooldown = new CooldownManager(totalCooldownTime = 3000)

    assert.that(cooldown.estaListo())
  }

  test "Al activarlo, deja de estar listo" {
    const cooldown = new CooldownManager(totalCooldownTime = 3000)

    cooldown.activar()

    assert.that(!cooldown.estaListo())
  }

  test "Si pasó menos tiempo que el total del cooldown, sigue sin estar listo" {
    const cooldown = new CooldownManager(totalCooldownTime = 3000)
    cooldown.activar()

    cooldown.onTimePassed(1000)

    assert.that(!cooldown.estaListo())
  }

  test "Si el tiempo pasado acumulado llega justo al total, vuelve a estar listo" {
    const cooldown = new CooldownManager(totalCooldownTime = 3000)
    cooldown.activar()

    cooldown.onTimePassed(1000)
    cooldown.onTimePassed(2000)

    assert.that(cooldown.estaListo())
  }

  test "Si el tiempo pasado supera el total, no rompe: el cooldown queda listo igual" {
    const cooldown = new CooldownManager(totalCooldownTime = 3000)
    cooldown.activar()

    cooldown.onTimePassed(5000)

    assert.that(cooldown.estaListo())
  }

  test "Activar de nuevo en medio de un cooldown en curso lo reinicia al total" {
    const cooldown = new CooldownManager(totalCooldownTime = 3000)
    cooldown.activar()
    cooldown.onTimePassed(2000)

    cooldown.activar()
    cooldown.onTimePassed(2000)

    assert.that(!cooldown.estaListo())
  }

}
