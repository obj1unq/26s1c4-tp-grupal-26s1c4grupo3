describe "Ataque del personaje principal con arco" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "Un esqueleto dentro del alcance del arco recibe el ataque y muere" {
    prisionero.position_(game.at(10, 5))
    prisionero.mover(arriba)
    prisionero.obtenerArma(arco)
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 13))
    game.addVisual(esqueleto)

    prisionero.atacar()

    assert.equals(0, esqueleto.vida())
    assert.that(!esqueleto.estaVivo())
  }

  test "Un esqueleto fuera del alcance del arco, tanto en profundidad como en ancho, no recibe daño" {
    prisionero.position_(game.at(10, 5))
    prisionero.mover(arriba)
    prisionero.obtenerArma(arco)
    const esqueletoMuyLejos = new EnemigoEsqueleto(position = game.at(10, 16))
    const esqueletoFueraDeAncho = new EnemigoEsqueleto(position = game.at(12, 13))
    game.addVisual(esqueletoMuyLejos)
    game.addVisual(esqueletoFueraDeAncho)

    prisionero.atacar()

    assert.equals(100, esqueletoMuyLejos.vida())
    assert.equals(100, esqueletoFueraDeAncho.vida())
  }

}

describe "Movimiento autónomo del enemigo hacia su objetivo" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "Si la diferencia en X hacia el objetivo es mayor que en Y, el enemigo se mueve un paso en el eje X" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.position_(game.at(15, 11))

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(11, 10), esqueleto.position())
  }

  test "Si la diferencia en Y hacia el objetivo es mayor que en X, el enemigo se mueve un paso en el eje Y" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.position_(game.at(11, 15))

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(10, 11), esqueleto.position())
  }

  test "Si la dirección principal está bloqueada por el límite del mapa, el enemigo se mueve en la dirección alternativa" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(1, 10))
    prisionero.position_(game.at(-2, 11))

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(1, 11), esqueleto.position())
  }

  test "Si el enemigo ya está en la misma posición que el objetivo, no se mueve" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.position_(game.at(10, 10))

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(10, 10), esqueleto.position())
  }

  test "Si las dos direcciones candidatas están bloqueadas, el enemigo no se mueve" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(1, 1))
    prisionero.position_(game.at(-2, -2))

    esqueleto.perseguir(prisionero)

    assert.equals(game.at(1, 1), esqueleto.position())
  }

}

describe "Comportamiento de ataque de los enemigos" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "Si el objetivo está en una posición adyacente (incluida la diagonal), el enemigo lo ataca en vez de moverse" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.position_(game.at(11, 11))
    prisionero.vida(100)

    esqueleto.actuar(prisionero)

    assert.equals(85, prisionero.vida())
    assert.equals(game.at(10, 10), esqueleto.position())
  }

  test "Si el objetivo está a 2 o más casilleros de distancia en cualquier eje, el enemigo se mueve hacia él en vez de atacar" {
    const esqueleto = new EnemigoEsqueleto(position = game.at(10, 10))
    prisionero.position_(game.at(13, 10))
    prisionero.vida(100)

    esqueleto.actuar(prisionero)

    assert.equals(100, prisionero.vida())
    assert.equals(game.at(11, 10), esqueleto.position())
  }

}

describe "Recolección de armas del nivel" {

  method initialize() {
    game.width(25)
    game.height(25)
    gestorArmas.iniciar()
    game.addVisual(prisionero)
    prisionero.equiparArma(sinArma)
  }

  test "Si el personaje está parado sobre un arma del nivel y la elige, queda equipada" {
    prisionero.position_(game.at(10, 6))
    gestorArmas.agregarArma(espadaEnMapa, game.at(10, 6))

    gestorArmas.intentarElegirArma()

    assert.that(prisionero.inventario().contains(espada))
  }

  test "Si el personaje no está parado sobre ningún arma, intentar elegir no hace nada" {
    prisionero.position_(game.at(0, 0))
    gestorArmas.agregarArma(espadaEnMapa, game.at(10, 6))

    gestorArmas.intentarElegirArma()

    assert.that(!prisionero.inventario().contains(espada))
  }

}

describe "Transición de nivel al completarlo y llegar a la puerta" {

  method initialize() {
    game.width(25)
    game.height(25)
  }

  test "Si el nivel está completo y el personaje está en la puerta, se detecta ambas condiciones" {
    nivel1.configurarEnemigos()
    nivel1.enemigosDelNivel().forEach({ enemigo => enemigo.recibirAtaque(1000) })
    prisionero.position_(game.at(12, 22))

    assert.that(nivel1.llegoALaPuerta())
    assert.that(nivel1.nivelCompleto())
  }

  test "Si el nivel NO está completo, aunque el personaje esté en la puerta, no se detecta como completo" {
    nivel1.configurarEnemigos()
    prisionero.position_(game.at(12, 22))

    assert.that(nivel1.llegoALaPuerta())
    assert.that(!nivel1.nivelCompleto())
  }

}
